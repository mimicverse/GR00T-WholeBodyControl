# Copy to config/pico_wbc_split.env and adapt both host addresses.
# This example is versioned; the machine-specific copy is intentionally ignored.
LOCAL_CONDA_ENV=groot-wbc-pico
SIM_INTERFACE=lo
# Documentation-only TEST-NET addresses: replace them with your LAN addresses.
WBC_HOST=192.0.2.20
COMMAND_PORT=5556
FEEDBACK_PORT=5557
DDS_STATE_PORT=5560
DDS_COMMAND_PORT=5561

# Remote host variables (used by scripts/run_remote_sonic_wbc.sh).
REMOTE_CONDA_ENV=groot-wbc-sonic-trt1013
WBC_INTERFACE=lo
SIM_HOST_IP=192.0.2.10

# SSH launcher variables (used only on the local workstation).
REMOTE_USER=robot
REMOTE_REPO=/home/robot/Work/GR00T-WholeBodyControl
